    "viewsContainers": {
      "activitybar": [
        {
          "id": "intentumdiffActivity",
          "title": "IntentumDiff",
          "icon": "resources/activity-icon.svg"
        }
      ]
    },
    "views": {
      "intentumdiffActivity": [
        {
          "id": "intentumdiff.dashboard",
          "name": "Review Dashboard",
          "type": "webview",
          "contextualTitle": "IntentumDiff"
        },
        {
          "id": "intentumdiff.review",
          "name": "Semantic Changes",
          "contextualTitle": "IntentumDiff"
        }
      ],
      "scm": [
        {
          "id": "intentumdiff.semanticChanges",
          "name": "Semantic Changes",
          "contextualTitle": "IntentumDiff"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "intentumdiff.dashboard",
        "contents": "Open this view to see the richer IntentumDiff review dashboard for saved working-tree semantic changes against `intentumdiff.ref`.\n[Refresh Semantic Review](command:intentumdiff.refreshReview)"
      },
      {
        "view": "intentumdiff.review",
        "contents": "Open this view to auto-refresh saved working-tree semantic changes against `intentumdiff.ref`. Use manual refresh if you need to rerun the review immediately.\n[Refresh Semantic Review](command:intentumdiff.refreshReview)"
      },
      {
        "view": "intentumdiff.semanticChanges",
        "contents": "Open this view to auto-refresh saved working-tree semantic changes against `intentumdiff.ref`. Use manual refresh if you need to rerun the review immediately.\n[Refresh Semantic Review](command:intentumdiff.refreshReview)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "intentumdiff.refreshReview",
          "when": "view == intentumdiff.dashboard || view == intentumdiff.review || view == intentumdiff.semanticChanges",
          "group": "navigation"
        },
        {
          "command": "intentumdiff.cycleReviewGrouping",
          "when": "view == intentumdiff.dashboard || view == intentumdiff.review || view == intentumdiff.semanticChanges",
          "group": "navigation@0"
        },
        {
          "command": "intentumdiff.openReviewPanel",
          "when": "view == intentumdiff.dashboard || view == intentumdiff.review || view == intentumdiff.semanticChanges",
          "group": "navigation@1"
        },
        {
          "command": "intentumdiff.openDiagnostics",
          "when": "view == intentumdiff.dashboard || view == intentumdiff.review || view == intentumdiff.semanticChanges",
          "group": "navigation@1"
        },
        {
          "command": "intentumdiff.clearReview",
          "when": "view == intentumdiff.dashboard || view == intentumdiff.review || view == intentumdiff.semanticChanges",
          "group": "navigation@2"
        }
      ],
      "editor/title": [
        {
          "command": "intentumdiff.openReviewPanel",
          "when": "isInDiffEditor",
          "group": "navigation@-10"
        },
        {
          "command": "intentumdiff.reviewPanel.openNativeDiff",
          "when": "activeWebviewPanelId == intentumdiff.reviewPanel",
          "group": "navigation@0"
        },
        {
          "command": "intentumdiff.reviewPanel.openSemanticOnlyDiff",
          "when": "activeWebviewPanelId == intentumdiff.reviewPanel",
          "group": "navigation@1"
        },
        {
          "command": "intentumdiff.reviewPanel.stageFile",
          "when": "activeWebviewPanelId == intentumdiff.reviewPanel",
          "group": "navigation@1.5"
        },
        {
          "command": "intentumdiff.reviewPanel.revertFile",
          "when": "activeWebviewPanelId == intentumdiff.reviewPanel",
          "group": "navigation@1.6"
        },
        {
          "command": "intentumdiff.reviewPanel.previousChange",
          "when": "activeWebviewPanelId == intentumdiff.reviewPanel",
          "group": "navigation@2"
        },
        {
          "command": "intentumdiff.reviewPanel.nextChange",
          "when": "activeWebviewPanelId == intentumdiff.reviewPanel",
          "group": "navigation@3"
        },
        {
          "command": "intentumdiff.reviewPanel.toggleRail",
          "when": "activeWebviewPanelId == intentumdiff.reviewPanel",
          "group": "1_layout@1"
        },
        {
          "command": "intentumdiff.reviewPanel.toggleEvidenceDrawer",
          "when": "activeWebviewPanelId == intentumdiff.reviewPanel",
          "group": "1_layout@2"
        },
        {
          "command": "intentumdiff.openSemanticOnlyDiff",
          "when": "intentumdiff.inSemanticDiff && !intentumdiff.semanticOnlyDiffVisible",
          "group": "navigation@0"
        },
        {
          "command": "intentumdiff.openFullDiff",
          "when": "intentumdiff.inSemanticDiff && intentumdiff.semanticOnlyDiffVisible",
          "group": "navigation@0"
        },
        {
          "command": "intentumdiff.previousSemanticChange",
          "when": "intentumdiff.inSemanticDiff",
          "group": "navigation@1"
        },
        {
          "command": "intentumdiff.nextSemanticChange",
          "when": "intentumdiff.inSemanticDiff",
          "group": "navigation@1"
        },
        {
          "command": "intentumdiff.collapseSemanticDiffContext",
          "when": "intentumdiff.semanticOnlyDiffVisible",
          "group": "navigation@2"
        },
        {
          "command": "intentumdiff.expandSemanticDiffContext",
          "when": "intentumdiff.semanticOnlyDiffVisible",
          "group": "navigation@2"
        },
        {
          "command": "intentumdiff.hideEditorDiff",
          "when": "resourceScheme == file && intentumdiff.editorDiffVisible",
          "group": "navigation@3"
        },
        {
          "command": "intentumdiff.showEditorDiff",
          "when": "resourceScheme == file && !intentumdiff.editorDiffVisible",
          "group": "navigation@3"
        },
        {
          "command": "intentumdiff.hideCommentChanges",
          "when": "resourceScheme == file && !intentumdiff.hideComments",
          "group": "navigation@4"
        },
        {
          "command": "intentumdiff.showCommentChanges",
          "when": "resourceScheme == file && intentumdiff.hideComments",
          "group": "navigation@4"
        },
        {
          "command": "intentumdiff.configureVisibleChangeTypes",
          "when": "resourceScheme == file",
          "group": "navigation@5"
        },
        {
          "command": "intentumdiff.hideEditorDiff",
          "when": "resourceScheme =~ /^intentumdiff-/ && intentumdiff.editorDiffVisible",
          "group": "navigation@3"
        },
        {
          "command": "intentumdiff.showEditorDiff",
          "when": "resourceScheme =~ /^intentumdiff-/ && !intentumdiff.editorDiffVisible",
          "group": "navigation@3"
        },
        {
          "command": "intentumdiff.hideCommentChanges",
          "when": "resourceScheme =~ /^intentumdiff-/ && !intentumdiff.hideComments",
          "group": "navigation@4"
        },
        {
          "command": "intentumdiff.showCommentChanges",
          "when": "resourceScheme =~ /^intentumdiff-/ && intentumdiff.hideComments",
          "group": "navigation@4"
        },
        {
          "command": "intentumdiff.configureVisibleChangeTypes",
          "when": "resourceScheme =~ /^intentumdiff-/",
          "group": "navigation@5"
        }
      ],
      "view/item/context": [
        {
          "command": "intentumdiff.openSemanticDiff",
          "when": "(view == intentumdiff.review || view == intentumdiff.semanticChanges) && viewItem =~ /intentumdiffReview/",
          "group": "inline"
        },
        {
          "command": "intentumdiff.openReviewPanel",
          "when": "(view == intentumdiff.review || view == intentumdiff.semanticChanges) && viewItem =~ /intentumdiffReview(File|Entry\\.|CrossFile$)/",
          "group": "navigation@0"
        },
        {
          "command": "intentumdiff.openSemanticOnlyDiff",
          "when": "(view == intentumdiff.review || view == intentumdiff.semanticChanges) && viewItem =~ /intentumdiffReview(File|Entry\\.|CrossFile$)/",
          "group": "navigation@1"
        },
        {
          "command": "intentumdiff.openFullDiff",
          "when": "(view == intentumdiff.review || view == intentumdiff.semanticChanges) && viewItem =~ /intentumdiffReview(File|Entry\\.|CrossFile$)/",
          "group": "navigation@2"
        }
      ]
    },
    "configurationDefaults": {
      "diffEditor.hideUnchangedRegions.enabled": true,
      "diffEditor.hideUnchangedRegions.contextLineCount": 1,
      "diffEditor.hideUnchangedRegions.minimumLineCount": 2,
      "diffEditor.hideUnchangedRegions.revealLineCount": 10
    },
    "configuration": {
      "title": "IntentumDiff",
      "properties": {
        "intentumdiff.executable": {
          "type": "string",
          "default": "intentumdiff",
          "scope": "machine",
          "description": "Machine/user-level path or command name for the IntentumDiff executable. Workspace values are ignored for safety."
        },
        "intentumdiff.ref": {
          "type": "string",
          "default": "HEAD",
          "description": "Git ref to compare live buffers against."
        },
        "intentumdiff.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable live semantic diff feedback."
        },
        "intentumdiff.debounceMs": {
          "type": "number",
          "default": 250,
          "minimum": 50,
          "description": "Debounce delay in milliseconds before sending a live diff request."
        },
        "intentumdiff.liveServer.engine": {
          "type": "string",
          "enum": ["auto", "native", "python"],
          "default": "auto",
          "description": "Which live-server engine to spawn when intentumdiff.executable is unset: 'auto' prefers the bundled native server when present, 'native' requires it (falls back to python with a warning if missing), 'python' always uses the Python CLI. An explicit intentumdiff.executable always wins."
        },
        "intentumdiff.review.maxAutoRetries": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "description": "Maximum consecutive automatic semantic-review retries after transient failures. Deterministic failures never auto-retry. Editing a file or running a manual refresh always resumes."
        },
        "intentumdiff.fuel": {
          "type": [
            "number",
            "string",
            "null"
          ],
          "default": null,
          "description": "Wasm fuel override passed to IntentumDiff live-server. Defaults to IntentumDiff's bounded parser fuel; set 'inf' only for trusted workspaces that need uncapped parsing."
        },
        "intentumdiff.trace": {
          "type": "boolean",
          "default": false,
          "description": "Write protocol traffic and server stderr to the IntentumDiff output channel."
        },
        "intentumdiff.review.pollIntervalMs": {
          "type": "number",
          "default": 5000,
          "minimum": 500,
          "description": "Fallback polling interval in milliseconds while the Semantic Changes view is visible and the VS Code Git status watcher is unavailable. File, save, rename, and Git status events still trigger refreshes immediately."
        },
        "intentumdiff.review.groupFilesBy": {
          "type": "string",
          "enum": [
            "auto",
            "none",
            "language",
            "schema",
            "languageThenSchema"
          ],
          "default": "auto",
          "description": "Controls how IntentumDiff groups files in Semantic Changes and the Review Dashboard. Auto stays flat for tiny single-language reviews, then groups mixed, larger, or schema-aware reviews."
        },
        "intentumdiff.review.diffSurface": {
          "type": "string",
          "enum": [
            "native",
            "panel"
          ],
          "enumDescriptions": [
            "Open reviews in VS Code's native diff editor with semantic decorations, intent CodeLens and Peek.",
            "Open reviews in the IntentumDiff semantic panel with per-hunk stage/revert, inline editing, collapsible non-semantic regions and syntax highlighting."
          ],
          "default": "native",
          "description": "Which surface a Semantic Changes selection opens: VS Code's native diff editor, or the IntentumDiff semantic review panel. Image assets always use the panel."
        },
        "intentumdiff.review.diffContextLines": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "maximum": 10,
          "description": "How many unchanged context lines to keep around each intent hunk in the IntentumDiff semantic panel before collapsing. 0 shows only the intent hunks; higher values show more surrounding code."
        },
        "intentumdiff.intent.explainer": {
          "type": "string",
          "enum": [
            "deterministic",
            "llm"
          ],
          "enumDescriptions": [
            "Fast, offline explanations composed from the change evidence (node role + actual before/after value).",
            "Enrich behavior-affecting changes with an LLM (see intentumdiff.intent.llm.*). Falls back to deterministic when unavailable."
          ],
          "default": "deterministic",
          "description": "How IntentumDiff explains the intent 'why' on hovers."
        },
        "intentumdiff.intent.llm.provider": {
          "type": "string",
          "enum": [
            "vscode-lm",
            "anthropic",
            "openai-compatible"
          ],
          "enumDescriptions": [
            "Use your existing GitHub Copilot (or other registered chat model) via VS Code's Language Model API — no API key, VS Code asks for consent.",
            "Bring-your-own Anthropic API key (stored in SecretStorage via 'IntentumDiff: Set Intent Explainer Key').",
            "Bring-your-own OpenAI-compatible endpoint — cloud (OpenAI) or a local/self-hosted server (Ollama, LM Studio, vLLM) via intentumdiff.intent.llm.baseUrl."
          ],
          "default": "vscode-lm",
          "markdownDescription": "LLM provider for intent explanations. `vscode-lm` uses VS Code's built-in models (Copilot) and never sends raw source. **⚠️ Any cloud provider means change summaries leave this machine** — see `intentumdiff.intent.llm.codeSharing` for exactly what is shared.",
          "scope": "machine-overridable"
        },
        "intentumdiff.intent.llm.baseUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "Endpoint for `anthropic`/`openai-compatible` providers. **⚠️ Everything the explainer shares is sent to this host.** Verbatim source (`full` sharing) is only honoured for loopback addresses (`localhost`, `127.0.0.0/8`, `[::1]`); any other host is capped to `signatures`.",
          "scope": "machine-overridable"
        },
        "intentumdiff.intent.llm.model": {
          "type": "string",
          "default": "",
          "markdownDescription": "Model name for the configured provider (free text; provider defaults apply when empty).",
          "scope": "machine-overridable"
        },
        "intentumdiff.intent.llm.codeSharing": {
          "type": "string",
          "enum": [
            "signatures",
            "facts",
            "full"
          ],
          "enumDescriptions": [
            "Send a locally-derived summary plus symbol names and param/return types (the public API surface). Never sends function bodies, statements, or literal values. Recommended balance of privacy and accuracy.",
            "Most private: send only structural facts (kind, arity, stub-vs-substantive, size, role, value-change category). No identifiers, no literals, no bodies — the model can't even name the symbol.",
            "Send the actual changed source code. Maximum accuracy, but only ever transmitted to a LOCAL endpoint (localhost Ollama/LM Studio/vLLM); cloud providers and Copilot are automatically downgraded to 'signatures' so raw code never leaves your machine."
          ],
          "default": "signatures",
          "markdownDescription": "How much the LLM explainer may see. `facts`: privacy-safe counts/enums only — no identifiers, no source. `signatures`: **⚠️ transmits identifiers** (symbol and parameter names) to the configured provider. `full`: **⚠️ raw source code is sent** — honoured ONLY for a local (loopback) endpoint; cloud endpoints are automatically capped to `signatures`.",
          "scope": "machine-overridable"
        },
        "intentumdiff.diagnostics.fuelPeakWarning": {
          "type": "number",
          "default": 20000000,
          "minimum": 0,
          "description": "Peak Wasm fuel consumed by one parser call before IntentumDiff UI diagnostics mark a file as over policy."
        },
        "intentumdiff.diagnostics.fuelPerKbWarning": {
          "type": "number",
          "default": 15000000,
          "minimum": 0,
          "description": "Normalized Wasm fuel per KB before IntentumDiff UI diagnostics mark a parser call as over policy."
        },
        "intentumdiff.diagnostics.fuelPerLineWarning": {
          "type": "number",
          "default": 1500000,
          "minimum": 0,
          "description": "Normalized Wasm fuel per line before IntentumDiff UI diagnostics mark a parser call as over policy."
        },
        "intentumdiff.schemas.fetchMode": {
          "type": "string",
          "enum": [
            "auto",
            "cache-only",
            "off"
          ],
          "default": "cache-only",
          "scope": "machine",
          "description": "Machine/user-level control for runtime JSON/YAML schema fetching. Workspace values are ignored for safety. 'auto' fetches HTTPS schemas with cache fallback, 'cache-only' uses existing cached schemas only, and 'off' disables schema fetching."
        },
        "intentumdiff.schemas.cacheTtlHours": {
          "type": "number",
          "default": 24,
          "minimum": 0,
          "description": "Hours before cached remote JSON/YAML schemas are considered stale."
        },
        "intentumdiff.schemas.allowPrivateHosts": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "description": "Machine/user-level opt-in for schema URLs that resolve to private, link-local, or loopback hosts. Workspace values are ignored for safety. Keep disabled unless you intentionally use internal schema servers."
        },
        "intentumdiff.diff.fallbackDiff": {
          "type": "boolean",
          "default": true,
          "description": "Show fallback token/text diffs when a semantic parser falls back. Disable to surface a warning instead."
        },
        "intentumdiff.diff.defaultMode": {
          "type": "string",
          "enum": [
            "full",
            "semanticOnly"
          ],
          "default": "full",
          "description": "Native diff mode used by Semantic Changes entries. 'full' opens the existing VS Code diff; 'semanticOnly' opens a filtered native diff containing only semantic change chunks."
        },
        "intentumdiff.diff.contextLines": {
          "type": "number",
          "default": 3,
          "minimum": 0,
          "description": "Context lines to include around each semantic change in semantic-only native diffs."
        },
        "intentumdiff.diff.hideComments": {
          "type": "boolean",
          "default": false,
          "description": "Hide changes whose semantic nodes are comments."
        },
        "intentumdiff.visualization.showAdditions": {
          "type": "boolean",
          "default": true,
          "description": "Show addition decorations."
        },
        "intentumdiff.visualization.showDeletions": {
          "type": "boolean",
          "default": true,
          "description": "Show deletion decorations, including inline deletion markers."
        },
        "intentumdiff.visualization.showModifications": {
          "type": "boolean",
          "default": true,
          "description": "Show modification decorations."
        },
        "intentumdiff.visualization.inlineDeletionMarkers": {
          "type": "boolean",
          "default": true,
          "description": "Show subtle modified-editor markers for inline deletions whose removed text no longer exists in the buffer."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "tsc -p ./ --noEmit",
    "test": "npm run compile && npm run test:unit",
    "test:unit": "node --test out/test/baseUri.test.js out/test/config.test.js out/test/contentClass.test.js out/test/gitStatus.test.js out/test/mapper.test.js out/test/protocol.test.js out/test/reviewActionModel.test.js out/test/reviewModel.test.js out/test/reviewRefresh.test.js out/test/reviewTimelineModel.test.js out/test/reviewTree.test.js out/test/reviewWebviewModel.test.js out/test/liveServerLaunch.test.js out/test/intentCodeLens.test.js out/test/intentExplain.test.js out/test/intentLlmPrompt.test.js out/test/releaseNotes.test.js out/test/selectionRange.test.js out/test/semanticOnlyDiff.test.js out/test/themeColors.test.js",
    "test:integration": "npm run compile && node out/test/integration/runTests.js",
    "test:semanticdiff-comparison": "npm run compile && node out/test/comparison/runComparison.js",
    "vsix": "npm run compile && vsce package --baseContentUrl https://github.com/buchochelliq-labs/intentumdiff-vscode/blob/HEAD --baseImagesUrl https://github.com/buchochelliq-labs/intentumdiff-vscode/raw/HEAD",
    "publish:vsce": "vsce publish --packagePath",
    "publish:ovsx": "ovsx publish",
    "dev:watch": "npm run watch"
  },
  "devDependencies": {
    "@highlightjs/cdn-assets": "^11.11.1",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^20.12.12",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.2",
    "jsdom": "^24.1.3",
    "ovsx": "1.0.2",
    "typescript": "^5.4.5"
  },
  "overrides": {
    "tmp": "0.2.7"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In untrusted workspaces the LLM explainer is capped to privacy-safe facts and its provider/endpoint/sharing settings cannot be escalated by workspace configuration.",
      "restrictedConfigurations": [
        "intentumdiff.intent.llm.provider",
        "intentumdiff.intent.llm.baseUrl",
        "intentumdiff.intent.llm.model",
        "intentumdiff.intent.llm.codeSharing"
      ]
    }
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.45"
  }
}
