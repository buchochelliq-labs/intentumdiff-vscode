{
  "name": "intentumdiff",
  "displayName": "IntentumDiff",
  "description": "Live semantic review that surfaces moved code, refactorings, and meaningful changes.",
  "version": "0.0.1",
  "publisher": "buchochelliq-labs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/buchochelliq-labs/intentumdiff-vscode.git"
  },
  "homepage": "https://github.com/buchochelliq-labs/intentumdiff-vscode",
  "bugs": {
    "url": "https://github.com/buchochelliq-labs/intentumdiff-vscode/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "semantic-diff",
    "semantic-review",
    "code-review",
    "refactoring",
    "scm",
    "diff"
  ],
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#172033",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished",
    "onCommand:intentumdiff.toggle",
    "onCommand:intentumdiff.toggleEditorDiff",
    "onCommand:intentumdiff.showEditorDiff",
    "onCommand:intentumdiff.hideEditorDiff",
    "onCommand:intentumdiff.toggleHideComments",
    "onCommand:intentumdiff.showCommentChanges",
    "onCommand:intentumdiff.hideCommentChanges",
    "onCommand:intentumdiff.configureVisibleChangeTypes",
    "onCommand:intentumdiff.restartServer",
    "onCommand:intentumdiff.diffActiveFile",
    "onCommand:intentumdiff.showOutput",
    "onCommand:intentumdiff.refreshReview",
    "onCommand:intentumdiff.cycleReviewGrouping",
    "onCommand:intentumdiff.openReviewDashboard",
    "onCommand:intentumdiff.openDiagnostics",
    "onCommand:intentumdiff.exportDiagnostics",
    "onCommand:intentumdiff.openReviewPanel",
    "onCommand:intentumdiff.reviewPanel.openNativeDiff",
    "onCommand:intentumdiff.reviewPanel.openSemanticOnlyDiff",
    "onCommand:intentumdiff.reviewPanel.stageFile",
    "onCommand:intentumdiff.reviewPanel.revertFile",
    "onCommand:intentumdiff.reviewPanel.previousChange",
    "onCommand:intentumdiff.reviewPanel.nextChange",
    "onCommand:intentumdiff.reviewPanel.toggleRail",
    "onCommand:intentumdiff.reviewPanel.toggleEvidenceDrawer",
    "onCommand:intentumdiff.openSemanticDiff",
    "onCommand:intentumdiff.openSemanticOnlyDiff",
    "onCommand:intentumdiff.openFullDiff",
    "onCommand:intentumdiff.openChange",
    "onCommand:intentumdiff.nextSemanticChange",
    "onCommand:intentumdiff.previousSemanticChange",
    "onCommand:intentumdiff.expandSemanticDiffContext",
    "onCommand:intentumdiff.collapseSemanticDiffContext",
    "onCommand:intentumdiff.clearReview",
    "onCommand:intentumdiff.revealActiveFileInReview",
    "onView:intentumdiff.dashboard",
    "onView:intentumdiff.review",
    "onView:intentumdiff.semanticChanges"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "walkthroughs": [
      {
        "id": "intentumdiff.gettingStarted",
        "title": "Get started with IntentumDiff",
        "description": "Review the intent behind your changes: pick a base ref, run a semantic review, read the intent, mind the guardrails, and pipe out release notes.",
        "steps": [
          {
            "id": "intentumdiff.gettingStarted.baseRef",
            "title": "Pick your base ref",
            "description": "IntentumDiff compares your working tree against `intentumdiff.ref` (default `HEAD`).\n[Open the setting](command:workbench.action.openSettings?%22intentumdiff.ref%22)",
            "media": {
              "markdown": "media/walkthroughs/base-ref.md"
            },
            "completionEvents": [
              "onSettingChanged:intentumdiff.ref"
            ]
          },
          {
            "id": "intentumdiff.gettingStarted.runReview",
            "title": "Run a semantic review",
            "description": "Parse the changed files and group them into intent.\n[Refresh Semantic Review](command:intentumdiff.refreshReview)",
            "media": {
              "markdown": "media/walkthroughs/run-review.md"
            },
            "completionEvents": [
              "onCommand:intentumdiff.refreshReview"
            ]
          },
          {
            "id": "intentumdiff.gettingStarted.readIntent",
            "title": "Read the intent",
            "description": "See what changed and why — open the IntentumDiff view, then pick a file from Semantic Changes.\n[Open the IntentumDiff view](command:workbench.view.extension.intentumdiffActivity)",
            "media": {
              "markdown": "media/walkthroughs/read-intent.md"
            },
            "completionEvents": [
              "onView:intentumdiff.review"
            ]
          },
          {
            "id": "intentumdiff.gettingStarted.guardrails",
            "title": "Watch the guardrails",
            "description": "Protected-symbol changes surface in Problems and pin to the top of the tree.\n[Open Problems](command:workbench.actions.view.problems)",
            "media": {
              "markdown": "media/walkthroughs/guardrails.md"
            },
            "completionEvents": [
              "onCommand:workbench.actions.view.problems"
            ]
          },
          {
            "id": "intentumdiff.gettingStarted.releaseNotes",
            "title": "Pipe out release notes",
            "description": "Open a file's review from the IntentumDiff view, then switch to the Release Notes rail — copy as Markdown or export JSON.\n[Open the IntentumDiff view](command:workbench.view.extension.intentumdiffActivity)",
            "media": {
              "markdown": "media/walkthroughs/release-notes.md"
            },
            "completionEvents": [
              "onView:intentumdiff.review"
            ]
          }
        ]
      }
    ],
